# Copy to deploy/.env, which stays out of git.
TAKO_DEPLOY_HOST=deploy@server.example.com
TAKO_DOMAIN=tako.example.com
# Docker network of the Caddy container that owns ports 80 and 443
PROXY_NETWORK=proxy
CADDY_CONTAINER=caddy
# Path on the host of the Caddyfile bind-mounted into that container
CADDYFILE=/srv/caddy/Caddyfile
